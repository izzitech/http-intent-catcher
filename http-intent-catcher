class IntentStore:
    """Process-local, in-memory store. Nothing is written to disk."""

    def __init__(self) -> None:
        self._items: list[dict[str, object]] = []
        self._next_id = 1
        self._lock = threading.Lock()

    def add(self, url: str) -> dict[str, object]:
        with self._lock:
            item = {
                "id": self._next_id,
                "url": url,
                "captured_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
            }
            self._next_id += 1
            self._items.append(item)
            return dict(item)

    def newest_first(self) -> list[dict[str, object]]:
        with self._lock:
            return [dict(item) for item in reversed(self._items)]

    def last(self) -> dict[str, object] | None:
        with self._lock:
            return dict(self._items[-1]) if self._items else None


STORE = IntentStore()


def is_http_url(value: str) -> bool:
    try:
        parsed = urlsplit(value)
    except ValueError:
        return False
    return parsed.scheme.lower() in {"http", "https"} and bool(parsed.netloc)


def notify_gnome(url: str) -> None:
    """Best-effort GNOME notification through libnotify's notify-send utility."""
    notify_send = shutil.which("notify-send")
    if not notify_send:
        return
    try:
        subprocess.Popen(
            [
                notify_send,
                "--app-name",
                APP_NAME,
                "--icon",
                "web-browser",
                "URL intercepted",
                url,
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError:
        pass


class Handler(BaseHTTPRequestHandler):
    server_version = "HTTPIntentCatcher/1.0"

    def log_message(self, fmt: str, *args: object) -> None:
        sys.stderr.write("%s - - [%s] %s\n" % (self.client_address[0], self.log_date_time_string(), fmt % args))

    def _send_bytes(self, status: int, body: bytes, content_type: str) -> None:
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(body)

    def _send_json(self, status: int, value: object) -> None:
        body = json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
        self._send_bytes(status, body, "application/json; charset=utf-8")

    def do_GET(self) -> None:
        path = self.path.split("?", 1)[0]
        if path == "/":
            self._send_bytes(HTTPStatus.OK, HTML_PAGE.encode("utf-8"), "text/html; charset=utf-8")
        elif path == "/api/intents":
            self._send_json(HTTPStatus.OK, STORE.newest_first())
        elif path == "/api/last":
            self._send_json(HTTPStatus.OK, STORE.last())
        elif path == "/api/health":
            self._send_json(HTTPStatus.OK, {"ok": True})
        else:
            self._send_json(HTTPStatus.NOT_FOUND, {"error": "not found"})

    def do_POST(self) -> None:
        path = self.path.split("?", 1)[0]
        if path != "/api/intents":
            self._send_json(HTTPStatus.NOT_FOUND, {"error": "not found"})
            return

        content_type = self.headers.get("Content-Type", "").split(";", 1)[0].strip().lower()
        if content_type != "application/json":
            self._send_json(HTTPStatus.UNSUPPORTED_MEDIA_TYPE, {"error": "application/json required"})
            return

        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            self._send_json(HTTPStatus.BAD_REQUEST, {"error": "invalid content length"})
            return
        if length <= 0 or length > MAX_BODY_BYTES:
            self._send_json(HTTPStatus.REQUEST_ENTITY_TOO_LARGE, {"error": "invalid body size"})
            return

        try:
            payload = json.loads(self.rfile.read(length).decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError):
            self._send_json(HTTPStatus.BAD_REQUEST, {"error": "invalid JSON"})
            return

        url = payload.get("url") if isinstance(payload, dict) else None
        if not isinstance(url, str) or not is_http_url(url):
            self._send_json(HTTPStatus.BAD_REQUEST, {"error": "url must be a valid http:// or https:// URL"})
            return

        item = STORE.add(url)
        notify_gnome(url)
        self._send_json(HTTPStatus.CREATED, item)


def serve(host: str, port: int) -> int:
    try:
        server = ThreadingHTTPServer((host, port), Handler)
    except OSError as exc:
        print(f"{APP_NAME}: cannot listen on http://{host}:{port}: {exc}", file=sys.stderr)
        return 1

    stop = threading.Event()

    def handle_signal(signum: int, frame: object) -> None:
        if not stop.is_set():
            stop.set()
            threading.Thread(target=server.shutdown, daemon=True).start()

    signal.signal(signal.SIGTERM, handle_signal)
    signal.signal(signal.SIGINT, handle_signal)

    print(f"{APP_NAME} listening on http://{host}:{port}")
    print(f"Last intent API: http://{host}:{port}/api/last")
    try:
        server.serve_forever(poll_interval=0.4)
    finally:
        server.server_close()
    return 0


def post_intent(url: str, port: int, timeout: float = 0.75) -> dict[str, object]:
    data = json.dumps({"url": url}).encode("utf-8")
    request = Request(
        f"http://{DEFAULT_HOST}:{port}/api/intents",
        data=data,
        method="POST",
        headers={"Content-Type": "application/json"},
    )
    with urlopen(request, timeout=timeout) as response:
        return json.load(response)


def server_is_healthy(port: int, timeout: float = 0.25) -> bool:
    try:
        with urlopen(f"http://{DEFAULT_HOST}:{port}/api/health", timeout=timeout) as response:
            return response.status == HTTPStatus.OK
    except OSError:
        return False


def capture(url: str, port: int) -> int:
    if not is_http_url(url):
        print(f"{APP_NAME}: refusing non-HTTP(S) URL: {url!r}", file=sys.stderr)
        return 2

    try:
        post_intent(url, port)
        return 0
    except OSError:
        pass

    # Nothing is listening yet. Start a detached in-memory server, then retry.
    executable = str(Path(sys.argv[0]).resolve())
    try:
        subprocess.Popen(
            [executable, "serve", "--port", str(port)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )
    except OSError as exc:
        print(f"{APP_NAME}: could not start server: {exc}", file=sys.stderr)
        return 1

    deadline = time.monotonic() + 2.5
    last_error: Exception | None = None
    while time.monotonic() < deadline:
        try:
            post_intent(url, port)
            return 0
        except OSError as exc:
            last_error = exc
            time.sleep(0.05)

    print(f"{APP_NAME}: server did not become available: {last_error}", file=sys.stderr)
    return 1


def desktop_exec_quote(path: str) -> str:
    # Desktop Entry Exec quoting: quote the executable token, not the %u field code.
    escaped = path.replace("\\", "\\\\").replace('"', '\\"').replace("`", "\\`").replace("$", "\\$")
    return f'"{escaped}"'


def install() -> int:
    home = Path.home()
    bin_dir = Path(os.environ.get("XDG_BIN_HOME", home / ".local" / "bin"))
    data_home = Path(os.environ.get("XDG_DATA_HOME", home / ".local" / "share"))
    app_dir = data_home / "applications"
    target = bin_dir / APP_ID
    desktop_path = app_dir / DESKTOP_FILE_NAME

    bin_dir.mkdir(parents=True, exist_ok=True)
    app_dir.mkdir(parents=True, exist_ok=True)

    source = Path(__file__).resolve()
    if source != target:
        shutil.copy2(source, target)
    target.chmod(target.stat().st_mode | 0o111)

    desktop = f"""[Desktop Entry]\nType=Application\nName={APP_NAME}\nComment=Capture HTTP and HTTPS URL intents in memory\nExec={desktop_exec_quote(str(target))} capture %u\nTerminal=false\nNoDisplay=true\nMimeType=x-scheme-handler/http;x-scheme-handler/https;\nIcon=web-browser\nStartupNotify=false\n"""
    desktop_path.write_text(desktop, encoding="utf-8")

    xdg_mime = shutil.which("xdg-mime")
    if not xdg_mime:
        print("xdg-mime was not found. Install xdg-utils, then rerun install.", file=sys.stderr)
        return 1

    previous = {}
    for scheme in ("http", "https"):
        mime = f"x-scheme-handler/{scheme}"
        try:
            q = subprocess.run([xdg_mime, "query", "default", mime], capture_output=True, text=True, check=False)
            previous[scheme] = q.stdout.strip() or "(none)"
        except OSError:
            previous[scheme] = "(unknown)"
        subprocess.run([xdg_mime, "default", DESKTOP_FILE_NAME, mime], check=True)

    update_db = shutil.which("update-desktop-database")
    if update_db:
        subprocess.run([update_db, str(app_dir)], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    print(f"Installed executable: {target}")
    print(f"Installed URL handler: {desktop_path}")
    print(f"Web UI: http://{DEFAULT_HOST}:{DEFAULT_PORT}/")
    print(f"Last intent API: http://{DEFAULT_HOST}:{DEFAULT_PORT}/api/last")
    print("Previous handlers (not persisted by this app):")
    print(f"  http:  {previous['http']}")
    print(f"  https: {previous['https']}")
    if not shutil.which("notify-send"):
        print("Note: notify-send is missing; install libnotify-bin for GNOME pop-up notifications.")
    print("The server starts automatically on the first intercepted URL, or run: http-intent-catcher serve")
    return 0


def uninstall() -> int:
    home = Path.home()
    bin_dir = Path(os.environ.get("XDG_BIN_HOME", home / ".local" / "bin"))
    data_home = Path(os.environ.get("XDG_DATA_HOME", home / ".local" / "share"))
    app_dir = data_home / "applications"
    target = bin_dir / APP_ID
    desktop_path = app_dir / DESKTOP_FILE_NAME

    if desktop_path.exists():
        desktop_path.unlink()
        print(f"Removed {desktop_path}")
    if target.exists():
        target.unlink()
        print(f"Removed {target}")

    update_db = shutil.which("update-desktop-database")
    if update_db and app_dir.exists():
        subprocess.run([update_db, str(app_dir)], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    print("This app intentionally stores no previous-browser config, so choose your browser again after uninstalling, e.g.:")
    print("  xdg-settings set default-web-browser firefox.desktop")
    return 0


def make_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    serve_p = sub.add_parser("serve", help="run the in-memory web server")
    serve_p.add_argument("--host", default=DEFAULT_HOST, help=f"listen host (default: {DEFAULT_HOST})")
    serve_p.add_argument("--port", type=int, default=DEFAULT_PORT, help=f"listen port (default: {DEFAULT_PORT})")

    capture_p = sub.add_parser("capture", help="capture one HTTP/HTTPS URL")
    capture_p.add_argument("url")
    capture_p.add_argument("--port", type=int, default=DEFAULT_PORT, help=argparse.SUPPRESS)

    sub.add_parser("install", help="install into ~/.local and register as the HTTP/HTTPS handler")
    sub.add_parser("uninstall", help="remove installed files; does not guess your previous browser")
    return parser


def main() -> int:
    args = make_parser().parse_args()
    if args.command == "serve":
        return serve(args.host, args.port)
    if args.command == "capture":
        return capture(args.url, args.port)
    if args.command == "install":
        return install()
    if args.command == "uninstall":
        return uninstall()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
